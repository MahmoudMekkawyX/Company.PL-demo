@model EmployeeDetailsDto
@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">
    <h3 class="text-info mb-4"><i class="fas fa-id-card me-2"></i>Employee Details</h3>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row">
                <!-- Basic Info -->
                <div class="col-md-6">
                    <h5 class="text-primary mb-3">Basic Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Age</dt>
                        <dd class="col-sm-8">@Model.Age</dd>

                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.Gender</dd>

                        <dt class="col-sm-4">Employee Type</dt>
                        <dd class="col-sm-8">@Model.EmployeeType</dd>

                        <dt class="col-sm-4">Is Active</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@Model.DepartmentName</dd>

                    </dl>
                </div>

                <!-- Contact Info -->
                <div class="col-md-6">
                    <h5 class="text-primary mb-3">Contact Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.Address</dd>

                        <dt class="col-sm-4">Salary</dt>
                        <dd class="col-sm-8 text-success fw-bold">@Model.Salary.ToString("C")</dd>

                        <dt class="col-sm-4">Hiring Date</dt>
                        <dd class="col-sm-8">@Model.HiringDate.ToString("yyyy-MM-dd")</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <!-- Audit Info -->
            <div class="row mt-3">
                <div class="col-md-12">
                    <h5 class="text-primary mb-3">Audit Information</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Created By</dt>
                        <dd class="col-sm-9">@Model.CreatedBy</dd>

                        <dt class="col-sm-3">Created On</dt>
                        <dd class="col-sm-9">@Model.CreatedOn.ToString("f")</dd>

                        <dt class="col-sm-3">Last Modified By</dt>
                        <dd class="col-sm-9">@Model.LastModifiedBy</dd>

                        <dt class="col-sm-3">Last Modified On</dt>
                        <dd class="col-sm-9">@Model.LastModifiedOn.ToString("f")</dd>
                    </dl>
                </div>
            </div>

            <div class="mt-4 text-end">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success me-2">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>